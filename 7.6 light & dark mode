
def light_mode():
    # Adding a light mode to comply with WCAG
    # Windows
    app.bg = "#C9C9C9"
    sign_window.bg = "#C9C9C9"
    review_window.bg = "#C9C9C9"

    # Boxes
    login_box.bg = "#FFFFFF"
    sign_box.bg = "#FFFFFF"
    review_exit_box.bg = "#FFFFFF"

    # Text
    app.text_color = "#000000"
    sign_window.text_color = "#000000"
    review_window.text_color = "#000000"


